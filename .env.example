# Runtime
APP_MODE=standalone
AUTH_MODE=dev
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://menu:menu@localhost:5433/menu?schema=public

# Messaging (Hito 3; requiere RabbitMQ)
# docker compose --profile messaging up -d rabbitmq
OUTBOX_PUBLISH_ENABLED=false
CONSUMERS_ENABLED=false
RABBITMQ_URL=amqp://menu:menu@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
CONSUMER_MAX_RETRIES=3

# Auth (Hito 3): AUTH_MODE=jwt exige una de estas dos claves RS256
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=

# Development
# APP_MODE=integrated exige AUTH_MODE=jwt y DEV_TOOLS_ENABLED=false
DEV_TOOLS_ENABLED=true
SEED_ON_START=true
PHOTO_STORAGE_PATH=./var/photos
