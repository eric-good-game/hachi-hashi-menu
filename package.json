{
  "name": "hachi-hashi-menu",
  "version": "0.1.0",
  "private": true,
  "description": "Menu/Catalog service for Hachi Hashi",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "seed": "ts-node -r tsconfig-paths/register src/seed/run-seed.ts",
    "seed:ids": "ts-node src/seed/export-seed-ids.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "tsc -p tsconfig.integration.json && node --test --test-concurrency=1 --test-timeout=120000 \"dist-integration/test/integration/**/*.test.js\"",
    "verify": "pnpm prisma generate && pnpm typecheck && pnpm test && pnpm build",
    "dev:jwt": "node scripts/dev-jwt.cjs",
    "dev:publish-availability": "node scripts/dev-inventory-publisher.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "6.19.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^2.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^18.0.8",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "slugify": "1.6.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/rabbitmq": "12.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "testcontainers": "12.2.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  }
}
