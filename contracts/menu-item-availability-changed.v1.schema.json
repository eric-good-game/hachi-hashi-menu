{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hachi-hashi.local/contracts/menu-item-availability-changed.v1.schema.json",
  "title": "MenuItemAvailabilityChanged v1 (consumido desde Inventory)",
  "type": "object",
  "required": [
    "messageId",
    "type",
    "version",
    "occurredAt",
    "source",
    "correlationId",
    "causationId",
    "payload"
  ],
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "type": { "const": "MenuItemAvailabilityChanged" },
    "version": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "source": { "const": "inventory" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": {
      "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "payload": {
      "type": "object",
      "required": ["menuItemId", "available"],
      "properties": {
        "menuItemId": { "type": "string", "format": "uuid" },
        "available": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
