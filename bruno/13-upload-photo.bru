meta {
  name: 13 Subir foto
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/api/menu/admin/items/{{itemId}}/photo
  body: multipart-form
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

body:multipart-form {
  file: @file(./fixtures/one.png)
}

script:post-response {
  bru.setVar("photoUrl", res.body.photoUrl);
}
