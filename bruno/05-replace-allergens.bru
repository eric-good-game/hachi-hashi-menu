meta {
  name: 05 Revisar alérgenos
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/menu/admin/items/{{itemId}}/allergens
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {
    "allergenCodes": ["pescado", "soya"]
  }
}
